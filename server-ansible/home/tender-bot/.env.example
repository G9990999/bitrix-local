# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ID чата/группы для уведомлений о событиях Bitrix24
TELEGRAM_CHAT_ID=-100XXXXXXXXX

# GigaChat credentials (Base64 от Client_ID:Client_Secret из личного кабинета)
GIGACHAT_CREDENTIALS=your_gigachat_credentials_base64

# Скоуп GigaChat API
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# URL Bitrix24 внутри Docker-сети
BITRIX_WEBHOOK_URL=http://bitrix-nginx

# URL обработчика вебхуков (этот же сервис)
HANDLER_BASE_URL=http://tender-bot:8000
